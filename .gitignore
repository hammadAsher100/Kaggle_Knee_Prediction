*.7z
*.zip
artifacts/metadata/*
artifacts/labels/*
artifacts/folds/*
artifacts/oof/*
artifacts/checkpoints/*
artifacts/predictions/*
artifacts/logs/*
artifacts/local/*
!artifacts/**/.gitkeep
