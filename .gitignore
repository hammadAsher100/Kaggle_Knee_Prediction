# Credentials and platform state. Never commit authentication material.
kaggle.json
**/kaggle.json
.kaggle/
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*

# Notebooks may be source-controlled; runtime state and outputs may not.
.ipynb_checkpoints/
kaggle/working/
kaggle/input/

# Competition data and generated artifacts must never be committed.
/data/
*.dcm
*.dicom
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.npz
*.npy
*.h5
*.hdf5
*.tar
